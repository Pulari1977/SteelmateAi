<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SteelMateAI</AssemblyName>
    <RootNamespace>SteelMateAI</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <!-- Compile against the oldest supported Tekla. At run time the Tekla API files are loaded from the Tekla that is running (see TeklaLocator.cs), so they are not copied next to the exe. -->
    <TeklaVersion>2025.0.0</TeklaVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2739.15" />
    <PackageReference Include="Tekla.Structures.Model" Version="$(TeklaVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Tekla.Structures.Drawing" Version="$(TeklaVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Tekla.Structures.Plugins" Version="$(TeklaVersion)" ExcludeAssets="runtime" />
    <Reference Include="System.Net.Http" /><Reference Include="System.Windows.Forms" /><Reference Include="System.Drawing" /><Reference Include="System.Design" /><Reference Include="PresentationCore" /><Reference Include="WindowsBase" />
    <Reference Include="System.Security" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
</Project>
